# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ── Base de datos (panel de gestión) ─────────────────────
# Local: `docker compose up -d db` levanta Postgres en 127.0.0.1:5434.
# Producción: la inyecta Railway (${{Postgres.DATABASE_URL}}, red privada).
DATABASE_URL=postgres://hodex:hodex_dev_only@localhost:5434/hodex

# ── Panel de gestión (admin.hodex.es) ────────────────────
# Sin DATABASE_URL + AUTH_ENCRYPTION_KEY (y en producción ADMIN_GATEWAY_SECRET
# con ADMIN_ORIGIN https), /api/admin responde 404: falla cerrado.
ADMIN_ORIGIN=http://localhost:5174
# Clave AES-256 para cifrar los secretos 2FA. ¡Si se pierde, hay que
# reconfigurar el 2FA! Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
# Secreto compartido con el nginx del panel (≥32 caracteres). Opcional en local.
# ADMIN_GATEWAY_SECRET=

# ── Email (opcional) ──────────────────────────────────────
# Sin estas variables, los envíos de contacto se registran en
# consola en vez de mandarse. Rellénalas para envío real (SMTP).
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# CONTACT_TO=hola@hodex.es
# CONTACT_FROM=Hodex <no-reply@hodex.es>
