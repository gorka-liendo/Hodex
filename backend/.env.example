# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# ── Base de datos (panel de gestión) ─────────────────────
# Local: `docker compose up -d db` levanta Postgres en 127.0.0.1:5434.
# Producción: la inyecta Railway (${{Postgres.DATABASE_URL}}, red privada).
DATABASE_URL=postgres://hodex:hodex_dev_only@localhost:5434/hodex

# ── Email (opcional) ──────────────────────────────────────
# Sin estas variables, los envíos de contacto se registran en
# consola en vez de mandarse. Rellénalas para envío real (SMTP).
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# CONTACT_TO=hola@hodex.es
# CONTACT_FROM=Hodex <no-reply@hodex.es>
