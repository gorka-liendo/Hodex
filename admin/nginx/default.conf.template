# admin.hodex.es — sirve el panel y hace de GATEWAY hacia el backend.
#
# Plantilla procesada al arrancar por la imagen oficial de nginx (envsubst):
#   ${PORT}                    puerto de escucha (Railway lo inyecta)
#   ${BACKEND_URL}             p. ej. http://backend.railway.internal:4000 (red privada)
#   ${ADMIN_GATEWAY_SECRET}    secreto compartido con el backend
#   ${NGINX_LOCAL_RESOLVERS}   DNS del contenedor (lo calcula la propia imagen)
# Las variables propias de nginx ($host, $uri…) no se tocan.

server_tokens off;

# IP real del cliente. Railway la entrega en X-Real-IP; si no llega, la del
# par TCP. Se reenvía al backend en una cabecera que solo acepta del gateway.
map $http_x_real_ip $hodex_client_ip {
    default $http_x_real_ip;
    ""      $remote_addr;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Re-resolver el DNS interno cada 10 s: si el backend se redespliega y
    # cambia de IP, el gateway lo sigue encontrando.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Comprobación de salud para Railway (no toca el backend).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ── API del panel → backend por la red privada ──────────────────────────
    location /api/admin/ {
        set $backend "${BACKEND_URL}";
        # Con variable y sin URI en proxy_pass, se reenvía la ruta original intacta.
        proxy_pass $backend;
        proxy_http_version 1.1;

        # Credencial del gateway: sustituye a cualquier valor que mande el cliente.
        proxy_set_header X-Hodex-Gateway "${ADMIN_GATEWAY_SECRET}";
        proxy_set_header X-Hodex-Client-IP $hodex_client_ip;
        proxy_set_header X-Forwarded-For $hodex_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_hide_header X-Powered-By;
    }

    # Adjuntos: subidas de hasta 10 MB y lectura con IA (puede tardar ~1 min).
    # Misma configuración que /api/admin/ salvo esos dos límites.
    location ^~ /api/admin/attachments {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;

        proxy_set_header X-Hodex-Gateway "${ADMIN_GATEWAY_SECRET}";
        proxy_set_header X-Hodex-Client-IP $hodex_client_ip;
        proxy_set_header X-Forwarded-For $hodex_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP "";

        client_max_body_size 11m;
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_hide_header X-Powered-By;
    }

    # Cualquier otra ruta de API no existe desde el panel.
    location /api/ {
        return 404;
    }

    # ── Estáticos ───────────────────────────────────────────────────────────
    # Assets con hash en el nombre → caché inmutable de un año.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: el resto cae en index.html, que nunca se cachea (así cada despliegue
    # se ve al instante).
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
